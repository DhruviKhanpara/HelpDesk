{
    "ConnectionStrings": {
        "TicketDbConnection": "connection string"
    },
    "Jwt": {
        "Issuer": "HelpDesk.AuthService",
        "Audience": "HelpDesk.Clients",
        "Secret": "your secret key",
        "AccessTokenExpirationMinutes": 15,
        "RefreshTokenExpirationDays": 30
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day"
                }
            },
            {
                "Name": "Seq",
                "Args": { "serverUrl": "http://localhost:5341" }
            }
        ]
    },
    "AllowedHosts": "*"
}
